class OdpPrecipitationSensor(CoordinatorEntity, RestoreSensor):
    def __init__(self, location_name, coordinator: HungaroMet10MinDataUpdateCoordinator) -> None:
        super().__init__(coordinator)

        self.entity_description = SensorEntityDescription(
            key="total_rain",
            name=f"HungaroMet - {location_name} total rain",
            state_class=SensorStateClass.TOTAL_INCREASING,
            device_class=SensorDeviceClass.PRECIPITATION,
            icon="mdi:weather-pouring",
            native_unit_of_measurement=UnitOfLength.MILLIMETERS,
        )
        self._latest_value = None
        self._latest_observation_time_stamp = None

    @property
    def native_value(self) -> float | None:
        if self.coordinator.data is None:
            return None

        if self._latest_observation_time_stamp is not None:
            unprocessed_data = self.coordinator.data.loc[
                self.coordinator.data.index > self._latest_observation_time_stamp
            ]["r"]
        else:
            unprocessed_data = self.coordinator.data["r"]
            self._latest_observation_time_stamp = (
                unprocessed_data.dropna().index.max().strftime("%Y-%m-%dT%H:%M:%SZ")
            )

            unprocessed_data = unprocessed_data.drop(unprocessed_data.index)

        if len(unprocessed_data) > 0:
            self._latest_observation_time_stamp = (
                unprocessed_data.dropna().index.max().strftime("%Y-%m-%dT%H:%M:%SZ")
            )
            self._latest_value = (self._latest_value or 0) + unprocessed_data.sum()

        return self._latest_value

    async def async_added_to_hass(self) -> None:
        """Executed when the sensor is added to Home Assistant."""
        await super().async_added_to_hass()

        try:
            last_state = await self.async_get_last_state()
            if last_state is not None:
                self._latest_observation_time_stamp = last_state.attributes.get(
                    "latest_observation_time_stamp"
                )

            last_sensor_data = await self.async_get_last_sensor_data()
            if last_sensor_data is not None:
                self._latest_value = last_sensor_data.native_value
        except Exception as e:
            LOGGER.error(e)
            self._latest_observation_time_stamp = None
            self._latest_value = None

    @property
    def state_attributes(self) -> dict[str, Any]:
        return {
            "latest_observation_time_stamp": self._latest_observation_time_stamp,
            "latest_value": self._latest_value,
        }


class OdpReferenceEvapotranspiration(CoordinatorEntity, RestoreSensor):
    def __init__(
        self,
        location_name,
        coordinator: HungaroMet10MinDataUpdateCoordinator,
    ) -> None:
        super().__init__(coordinator)

        self.entity_description = SensorEntityDescription(
            key="total_rain",
            name=f"HungaroMet - {location_name} total reference evapotranspiration",
            state_class=SensorStateClass.TOTAL_INCREASING,
            device_class=SensorDeviceClass.PRECIPITATION,
            icon="mdi:weather-sunny-alert",
            native_unit_of_measurement=UnitOfLength.MILLIMETERS,
        )
        self._latest_value = None
        self._latest_observation_time_stamp = None

    @property
    def native_value(self) -> float | None:
        if self.coordinator.data is None:
            return None

        if self._latest_observation_time_stamp is not None:
            unprocessed_data = self.coordinator.data["eto"].loc[
                self.coordinator.data.index > self._latest_observation_time_stamp
            ]
        else:
            unprocessed_data = self.coordinator.data["eto"]
            self._latest_observation_time_stamp = (
                unprocessed_data.dropna().index.max().strftime("%Y-%m-%dT%H:%M:%SZ")
            )
            unprocessed_data = unprocessed_data.drop(unprocessed_data.index)

        if len(unprocessed_data) > 0:
            self._latest_observation_time_stamp = (
                unprocessed_data.dropna().index.max().strftime("%Y-%m-%dT%H:%M:%SZ")
            )
            self._latest_value = (self._latest_value or 0) + unprocessed_data.sum()

        return self._latest_value

    async def async_added_to_hass(self) -> None:
        """Executed when the sensor is added to Home Assistant."""
        await super().async_added_to_hass()

        try:
            last_state = await self.async_get_last_state()
            if last_state is not None:
                self._latest_observation_time_stamp = last_state.attributes.get(
                    "latest_observation_time_stamp"
                )

            last_sensor_data = await self.async_get_last_sensor_data()
            if last_sensor_data is not None:
                self._latest_value = last_sensor_data.native_value
        except Exception as e:
            LOGGER.exception(e)
            self._latest_observation_time_stamp = None
            self._latest_value = None

    @property
    def state_attributes(self) -> dict[str, Any]:
        return {
            "latest_observation_time_stamp": self._latest_observation_time_stamp,
            "latest_value": self._latest_value,
        }

